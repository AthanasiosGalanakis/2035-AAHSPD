title: The Housing Contracts Affair
subtitle: A corruption scandal in one of our Länder
new-page: true
view-if: year = 2029 and month >= 11 and spd_states
max-visits: 1
on-arrival: sklarek_affair_seen = 1; workers_spd -= 1; new_middle_spd -= 1; old_middle_spd -= 1; rural_spd -= 1; catholics_spd -= 1; unemployed_spd -= 1; trust_in_democracy -= 2
