title: Status
new-page: true
is-special: true
on-arrival: {!
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= Status

[+ month : month +] [+ year +]

Resources available: [+ resources +]

{!<span class="ideology-tooltip-wrap seat spd" data-tip="spd" tabindex="0">SPD</span>!} position: [? if spd_toleration : toleration ?][? if spd_in_government : in government - ?][? if spd_toleration == 0 and spd_in_government == 0 and spd_caretaker == 0 : opposition ?][? if spd_caretaker : caretaker government ?]
[? if spd_in_government : [+ coalition_name +] ?][? if spd_in_government = 0 : Government: [+ coalition_name +] ?]

[? if spd_in_government and not in_spd_majority and not in_left_front : Coalition dissent: [+ coalition_dissent : coalition_dissent +] ?]

[? if spd_in_government and (in_left_front or in_popular_front): Linke coalition dissent: [+ linke_coalition_dissent : coalition_dissent +] ?]

Internal dissent: [+ dissent_percent : dissent +]

= Government

President: [+ president +]

Chancellor: [+ chancellor +] [? if chancellor_party = "SPD" : ({!<span class="ideology-tooltip-wrap seat spd" data-tip="spd" tabindex="0">SPD</span>!})?][? if chancellor_party = "CDU" and csu_split = 0 : ({!<span class="ideology-tooltip-wrap seat cdu" data-tip="cducsu" tabindex="0">CDU/CSU</span>!})?][? if chancellor_party = "CDU" and csu_split = 1 : ({!<span class="ideology-tooltip-wrap seat cdu" data-tip="cdu" tabindex="0">CDU</span>!})?][? if chancellor_party = "CSU" : ({!<span class="ideology-tooltip-wrap seat csu" data-tip="csu" tabindex="0">CSU</span>!})?][? if chancellor_party = "Grüne" : ({!<span class="ideology-tooltip-wrap seat greens" data-tip="greens" tabindex="0">Grüne</span>!})?][? if chancellor_party = "Linke" : ({!<span class="ideology-tooltip-wrap seat linke" data-tip="linke" tabindex="0">Linke</span>!})?][? if chancellor_party = "FDP" : ({!<span class="ideology-tooltip-wrap seat fdp" data-tip="fdp" tabindex="0">FDP</span>!})?][? if chancellor_party = "BSW" : ({!<span class="ideology-tooltip-wrap seat bsw" data-tip="bsw" tabindex="0">BSW</span>!})?][? if chancellor_party = "AfD" : ({!<span class="ideology-tooltip-wrap seat afd" data-tip="afd" tabindex="0">AfD</span>!})?]

Next election: [+ next_election_month : month +] [+ next_election_year +]

