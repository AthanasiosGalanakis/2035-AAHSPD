title: Status
new-page: true
is-special: true
on-arrival: {!
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= Status

[+ month : month +] [+ year +]

Resources available: [+ resources +]

SPD position: [? if spd_toleration : toleration ?][? if spd_in_government : in government - ?][? if spd_toleration == 0 and spd_in_government == 0 and spd_caretaker == 0 : opposition ?][? if spd_caretaker : caretaker government ?]
[? if in_weimar_coalition and spd_in_government: Weimar Coalition ?][? if in_grand_coalition and spd_in_government: Grand Coalition ?][? if in_popular_front and spd_in_government: Popular Front ?][? if in_left_front and spd_in_government: Left Front ?][? if in_spd_majority and spd_in_government: SPD majority ?][? if in_minority_government and spd_in_government: minority government ?][? if in_emergency_government and spd_in_government: emergency government ?]

[? if spd_in_government and not in_spd_majority and not in_left_front : Coalition dissent: [+ coalition_dissent : coalition_dissent +] ?]

[? if spd_in_government and (in_left_front or in_popular_front): KPD coalition dissent: [+ kpd_coalition_dissent : coalition_dissent +] ?]

Internal dissent: [+ dissent_percent : dissent +]

= Government

President: [+ president +]

Chancellor: [+ chancellor +] ([+ chancellor_party +])\

Next election: [+ next_election_month : month +] [+ next_election_year +]

= Bundestag Composition

[? if linke_r >= 5 : {!<span class="ideology-tooltip-wrap seat linke" tabindex="0">Linke<span class="ideology-tooltip-tip"><strong class="ideology-tooltip-title">Die Linke</strong><span class="ideology-tooltip-description">Democratic socialists to the left of the SPD.</span></span></span>!}: [+ linke_r +]% ?]

[? if greens_r >= 5 : {!<span class="ideology-tooltip-wrap seat greens" tabindex="0">Grüne<span class="ideology-tooltip-tip"><strong class="ideology-tooltip-title">Bündnis 90/Die Grünen</strong><span class="ideology-tooltip-description">Ecological, socially liberal and pro-European.</span></span></span>!}: [+ greens_r +]% ?]

[? if spd_r >= 5 : {!<span class="ideology-tooltip-wrap seat spd" tabindex="0">SPD<span class="ideology-tooltip-tip"><strong class="ideology-tooltip-title">Sozialdemokratische Partei Deutschlands</strong><span class="ideology-tooltip-description">Centre-left social democrats. Your party.</span></span></span>!}: [+ spd_r +]% ?]

[? if csu_split = 0 and cdu_r >= 5 : {!<span class="ideology-tooltip-wrap seat cdu" tabindex="0">CDU/CSU<span class="ideology-tooltip-tip"><strong class="ideology-tooltip-title">Union (CDU/CSU)</strong><span class="ideology-tooltip-description">Centre-right Christian democrats and their Bavarian sister party.</span></span></span>!}: [+ cdu_r +]% ?]

[? if csu_split = 1 and cdu_r >= 5 : {!<span class="ideology-tooltip-wrap seat cdu" tabindex="0">CDU<span class="ideology-tooltip-tip"><strong class="ideology-tooltip-title">Christlich Demokratische Union</strong><span class="ideology-tooltip-description">Centre-right Christian democrats, active outside Bavaria.</span></span></span>!}: [+ cdu_r +]% ?]

[? if csu_split = 1 and csu_r >= 5 : {!<span class="ideology-tooltip-wrap seat csu" tabindex="0">CSU<span class="ideology-tooltip-tip"><strong class="ideology-tooltip-title">Christlich-Soziale Union</strong><span class="ideology-tooltip-description">Bavarian conservatives, now running separately from the CDU.</span></span></span>!}: [+ csu_r +]% ?]

[? if fdp_r >= 5 : {!<span class="ideology-tooltip-wrap seat fdp" tabindex="0">FDP<span class="ideology-tooltip-tip"><strong class="ideology-tooltip-title">Freie Demokratische Partei</strong><span class="ideology-tooltip-description">Pro-market liberals.</span></span></span>!}: [+ fdp_r +]% ?]

[? if bsw_r >= 5 : {!<span class="ideology-tooltip-wrap seat bsw" tabindex="0">BSW<span class="ideology-tooltip-tip"><strong class="ideology-tooltip-title">Bündnis Sahra Wagenknecht</strong><span class="ideology-tooltip-description">Left on economics, conservative on migration and culture.</span></span></span>!}: [+ bsw_r +]% ?]

[? if afd_r >= 5 : {!<span class="ideology-tooltip-wrap seat afd" tabindex="0">AfD<span class="ideology-tooltip-tip"><strong class="ideology-tooltip-title">Alternative für Deutschland</strong><span class="ideology-tooltip-description">Far-right nationalists opposed to immigration.</span></span></span>!}: [+ afd_r +]% ?]

= Economics

[? if spd_in_government = 1 : Budget: [+ budget +] ?]

Inflation: [+ inflation_2 +]%

[? if black_thursday_seen = 1 : Unemployment: [+ unemployed_2 +]% ?]

