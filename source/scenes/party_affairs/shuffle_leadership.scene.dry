####################### adding advisors

@add_advisors
title: Add advisors
choose-if: n_advisors < 3
unavailable-subtitle: Maximum of 3 advisors.
go-to: advisor_menu

@advisor_menu
title: Add other advisors.
tags: center_advisor, left_advisor, reformist_advisor, labor_advisor, nonfactional_advisor
frequency: 1

- @centrist: Add advisors from Netzwerk Berlin
- @left: Add advisors from the Parlamentarische Linke
- @reformist: Add advisors from the Seeheimer Kreis
- @labor: Add advisors from the AfA
- @nonfactional: Add non-factional advisors
- @rm_main: Remove advisors instead.
- @remove_none: Stop changing advisors.

@centrist
view-if: n_advisors < 3

- #center_advisor

@reformist
view-if: n_advisors < 3

- #reformist_advisor

@left
view-if: n_advisors < 3

- #left_advisor

@labor
view-if: n_advisors < 3

- #labor_advisor

@nonfactional
view-if: n_advisors < 3

- #nonfactional_advisor

@add_miersch
title: Matthias Miersch
subtitle: Chair of the SPD parliamentary group, long-time spokesperson of the Parlamentarische Linke. {!<br><br>!}Actions: Building the Left, Unity of the Left, Talks with the Linke
is-card: true
tags: left_advisor
view-if: miersch_advisor = 0 and n_advisors < 3 and left_split = 0
on-arrival: miersch_advisor = 1; n_advisors += 1; left_strength += 3
go-to: advisor_menu

